# Example environment variables for ClearEye work-app

# PostgreSQL connection (overridden in compose.yaml to point to the db container)
DATABASE_URL=postgresql://workapp:yourpassword@localhost:5432/workapp

# Password for the Postgres container (used by compose.yaml for both app and db services)
POSTGRES_PASSWORD=

# Required by @auth/sveltekit — generate with: openssl rand -hex 32
AUTH_SECRET=
# Public origin of the app — used by SvelteKit adapter-node for CSRF protection
ORIGIN=http://localhost:5173
# Base URL for OAuth callbacks — must include /auth basepath, must match ORIGIN
AUTH_URL=http://localhost:5173/auth

# Google OAuth (used by @auth/sveltekit)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI provider selection: 'gemini' | 'openai' | 'anthropic'
AI_PROVIDER=gemini

# API keys for AI providers (only set the one(s) you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
